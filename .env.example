# Copy to .env and fill in. Never commit real values.

# NASA Earthdata Login token (DATA). Only needed for ingestion, never for the demo.
EARTHDATA_TOKEN=

# LLM for the verdict rewrite (API & AI). Leave empty to use template text only.
LLM_API_KEY=
LLM_MODEL=claude-haiku-5-5

# Comma-separated origins allowed to call the API (WEB dev server + Vercel URL)
ALLOWED_ORIGINS=http://localhost:3000

# 1 = serve the SYNTHETIC fixture when a result is not cached (dev only). Set 0 for the demo.
USE_FIXTURES=1

CODE_VERSION=0.1.0

# Web app
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
