{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fixtures": "node scripts/make-fixtures.mjs",
    "check:fixtures": "jiti scripts/check-fixtures.ts",
    "gen:types": "openapi-typescript ${OPENAPI_URL:-http://localhost:8000/openapi.json} -o types/api.generated.ts",
    "verify": "npm run typecheck && npm run lint && npm run check:fixtures && npm run build",
    "postinstall": "node scripts/copy-cesium.mjs",
    "cesium:assets": "node scripts/copy-cesium.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "@types/three": "^0.187.0",
    "cesium": "^1.147.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "d3-scale-chromatic": "^3.1.1",
    "echarts": "^6.1.0",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "three": "^0.187.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/d3-scale-chromatic": "^3.1.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
