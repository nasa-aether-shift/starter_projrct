# Copy to .env.local. Never commit real values.

# Base URL of the API, including /api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# 1 = answer every API call from ./fixtures (SYNTHETIC data, shows a warning banner). 0 = real API.
NEXT_PUBLIC_USE_FIXTURES=1

# cesium = 3D globe. static = image hero + region picker (fallback if Cesium misbehaves on venue hardware).
NEXT_PUBLIC_GLOBE_MODE=cesium

# Optional Cesium ion token for Cesium World Terrain. Empty = smooth ellipsoid terrain.
NEXT_PUBLIC_CESIUM_ION_TOKEN=

# 1 = enable high dynamic range rendering on the globe (heavier GPU). Default off.
NEXT_PUBLIC_GLOBE_HDR=0

# 1 = ask the browser for the visitor's location and focus the globe on it (never leaves the browser).
# Set 0 on the projector machine so no permission prompt appears during the pitch.
NEXT_PUBLIC_AUTO_LOCATE=1
